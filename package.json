{
  "name": "@dankwielclaw/dsh-plugin-session-delete",
  "version": "1.0.0",
  "description": "Gunthe 0.2 session permanent-delete action with exact-ID targeting and confirmation.",
  "type": "module",
  "license": "MIT",
  "repository": "https://github.com/DankwielClaw/dsh-plugin-session-delete",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "files": ["src/", "test/", "cordis.patch.yml"],
  "engines": { "node": ">=20" },
  "scripts": { "test": "node --test test/*.test.js" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-ui-workspace", "@deepseek-ai/dsh-client-ui-primitives"]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-projection-cache": "0.2.0-rc.2",
    "@deepseek-ai/dsh-workspace": "0.2.0-rc.2"
  }
}
